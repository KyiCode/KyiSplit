{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:artifact": "npm run build && npm --prefix ../frontend run build && node scripts/buildArtifact.mjs && npm --prefix ../release/kyisplit ci --omit=dev --ignore-scripts",
    "archive:artifact": "node scripts/archiveArtifact.mjs",
    "audit:artifact": "node scripts/auditArtifact.mjs",
    "dev": "tsx watch src/server.ts",
    "e2e:server": "npm run build:artifact && tsx e2e/server.ts",
    "e2e:schema": "tsx e2e/schemaGate.ts",
    "schema:check": "tsx scripts/checkSchema.ts",
    "db:info": "flyway -configFiles=flyway.conf info",
    "db:migrate": "flyway -configFiles=flyway.conf migrate",
    "db:migrate:release": "node scripts/runProfile.mjs prod migrate",
    "db:validate": "flyway -configFiles=flyway.conf validate",
    "db:info:local": "node scripts/runProfile.mjs local info",
    "db:migrate:local": "node scripts/runProfile.mjs local migrate",
    "db:validate:local": "node scripts/runProfile.mjs local validate",
    "db:info:prod": "node scripts/runProfile.mjs prod info",
    "db:migrate:prod": "node scripts/runProfile.mjs prod migrate",
    "db:validate:prod": "node scripts/runProfile.mjs prod validate",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "dev:local": "node scripts/runProfile.mjs local dev",
    "dev:prod": "node scripts/runProfile.mjs prod dev",
    "start:local": "node scripts/runProfile.mjs local start",
    "start:prod": "node scripts/runProfile.mjs prod start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
