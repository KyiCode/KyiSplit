  "functions": [
    {
      "schema_name": "public",
      "name": "kyisplit_assert_expense_balanced",
      "language": "plpgsql",
      "body": "\r\nDECLARE\r\n    affected_ids uuid[];\r\n    affected_id uuid;\r\n    expense_total numeric;\r\n    payment_total numeric;\r\n    split_total numeric;\r\nBEGIN\r\n    IF TG_TABLE_NAME = 'expenses' THEN\r\n        IF TG_OP = 'DELETE' THEN\r\n            affected_ids := ARRAY[OLD.id];\r\n        ELSE\r\n            affected_ids := ARRAY[NEW.id];\r\n        END IF;\r\n    ELSIF TG_OP = 'INSERT' THEN\r\n        affected_ids := ARRAY[NEW.expense_id];\r\n    ELSIF TG_OP = 'DELETE' THEN\r\n        affected_ids := ARRAY[OLD.expense_id];\r\n    ELSE\r\n        affected_ids := ARRAY[OLD.expense_id, NEW.expense_id];\r\n    END IF;\r\n\r\n    FOR affected_id IN SELECT DISTINCT unnest(affected_ids)\r\n    LOOP\r\n        SELECT\r\n            expense.total,\r\n            COALESCE((\r\n                SELECT sum(payment.amount)\r\n                FROM public.payments AS payment\r\n                WHERE payment.expense_id = expense.id\r\n            ), 0),\r\n            COALESCE((\r\n                SELECT sum(split.amount)\r\n                FROM public.splits AS split\r\n                WHERE split.expense_id = expense.id\r\n            ), 0)\r\n        INTO expense_total, payment_total, split_total\r\n        FROM public.expenses AS expense\r\n        WHERE expense.id = affected_id;\r\n\r\n        IF NOT FOUND THEN\r\n            CONTINUE;\r\n        END IF;\r\n        IF payment_total <> expense_total THEN\r\n            RAISE EXCEPTION\r\n                'Expense % payments sum % does not equal total %',\r\n                affected_id, payment_total, expense_total;\r\n        END IF;\r\n        IF split_total <> expense_total THEN\r\n            RAISE EXCEPTION\r\n                'Expense % splits sum % does not equal total %',\r\n                affected_id, split_total, expense_total;\r\n        END IF;\r\n    END LOOP;\r\n\r\n    RETURN NULL;\r\nEND\r\n"
    },
    {
      "schema_name": "public",
      "name": "kyisplit_protect_expense_fx",
      "language": "plpgsql",
      "body": "\r\nBEGIN\r\n    IF TG_OP = 'UPDATE' THEN\r\n        RAISE EXCEPTION 'Expense FX snapshot % is immutable', OLD.expense_id;\r\n    END IF;\r\n    IF EXISTS (\r\n        SELECT 1 FROM public.expenses WHERE id = OLD.expense_id\r\n    ) THEN\r\n        RAISE EXCEPTION\r\n            'Expense FX snapshot % is immutable while its expense exists',\r\n            OLD.expense_id;\r\n    END IF;\r\n    RETURN OLD;\r\nEND\r\n"
    },
    {
      "schema_name": "public",
      "name": "kyisplit_assert_expense_has_fx",
      "language": "plpgsql",
      "body": "\r\nDECLARE\r\n    affected_id uuid;\r\nBEGIN\r\n    IF TG_TABLE_NAME = 'expenses' THEN\r\n        affected_id := CASE\r\n            WHEN TG_OP = 'DELETE' THEN OLD.id\r\n            ELSE NEW.id\r\n        END;\r\n    ELSE\r\n        affected_id := CASE\r\n            WHEN TG_OP = 'DELETE' THEN OLD.expense_id\r\n            ELSE NEW.expense_id\r\n        END;\r\n    END IF;\r\n\r\n    IF EXISTS (\r\n        SELECT 1 FROM public.expenses WHERE id = affected_id\r\n    ) AND NOT EXISTS (\r\n        SELECT 1\r\n        FROM public.expense_fx_snapshots\r\n        WHERE expense_id = affected_id\r\n          AND rate IS NOT NULL\r\n          AND provider IS NOT NULL\r\n    ) THEN\r\n        RAISE EXCEPTION\r\n            'Expense % is missing a finalized FX snapshot', affected_id;\r\n    END IF;\r\n    RETURN NULL;\r\nEND\r\n"
    }
  ]
